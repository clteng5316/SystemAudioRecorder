#include <windows.h>
#include <winver.h>
#include "resource.h"

#ifndef VS_VERSION_INFO
#define VS_VERSION_INFO 1
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,1
 PRODUCTVERSION 2,0,0,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040404b0"
        BEGIN
            VALUE "CompanyName", "Teng Chuan-Liang\0"
            VALUE "FileDescription", "System Audio Spectrum + MP3 + URL Media Download\0"
            VALUE "FileVersion", "2.0-beta.1\0"
            VALUE "InternalName", "SystemAudioRecorder\0"
            VALUE "OriginalFilename", "SystemAudioRecorder.exe\0"
            VALUE "ProductName", "SystemAudioRecorder\0"
            VALUE "ProductVersion", "2.0-beta.1\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Teng Chuan-Liang\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0404, 1200
    END
END
